# Copy to .env and fill in your values. Never commit .env to git.

# LLM backend: "nvidia", "gemini", "groq", "openrouter" or "ollama"
ARPA_LLM_BACKEND=nvidia

# ---------------------------------------------------------------------------
# NVIDIA NIM — free tier, get a key from https://build.nvidia.com/
#
# The model choice here is not cosmetic. Extraction reads ~28k characters of
# paper per pass, and a small model drops fields at that size: on
# llama-3.1-8b, one paper lost model_name entirely and another lost the
# channel from input_shape ([1,28,28] -> [28,28]), which then crashed the
# generated code on a channel mismatch. Smoke execution measured 6/10 on the
# 8b model and 10/10 on the 120b one, with everything else identical.
#
# nemotron-3-super-120b-a12b is a sparse MoE (~12B active per token), so it is
# far cheaper to run than its size suggests, and it stayed responsive on the
# free tier through outages that took llama-3.1-8b and llama-3.3-70b offline.
# Expect roughly 1.5-2x the wall-clock of an 8b model per call.
ARPA_NVIDIA_API_KEY=your_key_here
ARPA_NVIDIA_BASE_URL=https://integrate.api.nvidia.com
ARPA_NVIDIA_GENERAL_MODEL=nvidia/nemotron-3-super-120b-a12b
ARPA_NVIDIA_CODE_MODEL=nvidia/nemotron-3-super-120b-a12b

# Groq — free tier, no card required, https://console.groq.com
# Useful when NVIDIA's shared tier degrades. Note the free tier caps at 12k
# tokens/minute AND 100k tokens/day on the 70b model; a full 10-paper run can
# exhaust the daily budget on its own.
# ARPA_GROQ_API_KEY=your_key_here
# ARPA_GROQ_MODEL=llama-3.3-70b-versatile

# Gemini — get a key from https://aistudio.google.com/app/apikey
ARPA_GEMINI_API_KEY=your_key_here
ARPA_GEMINI_GENERAL_MODEL=gemini-2.5-flash-lite
ARPA_GEMINI_CODE_MODEL=gemini-2.5-flash-lite

# Ollama (if ARPA_LLM_BACKEND=ollama)
ARPA_OLLAMA_BASE_URL=http://localhost:11434
ARPA_OLLAMA_GENERAL_MODEL=mistral:7b-instruct
ARPA_OLLAMA_CODE_MODEL=qwen2.5-coder:7b

# Optional
ARPA_DATASET_VERIFY_MAX_RETRIES=3

# Docker sandbox (dataset-loading verification). Requires Docker Desktop/Engine
# running locally and the image built once via:
#   docker build -t arpa-sandbox:latest docker/sandbox
# Falls back to local subprocess verification automatically if Docker isn't
# reachable, so these are only needed if you want to tune the sandbox.
ARPA_DOCKER_SANDBOX_IMAGE=arpa-sandbox:latest
# Leave unset for an offline container (no network egress). Set this if a
# dataset's loading code needs to download from inside the container (e.g.
# HuggingFace/TFDS downloads) rather than relying on a pre-populated cache.
# ARPA_DOCKER_NETWORK=bridge
# Seconds to wait for a single verification run before giving up. Increase for
# datasets that download large archives on first run.
ARPA_DOCKER_VERIFY_TIMEOUT_S=300
